# ---- runtime artifacts -------------------------------------------------------
*.log
*.pid
history.txt
history.txt.tmp

# ...but bench/raw/ IS the evidence, so it gets committed
!bench/raw/*.log
!bench/raw/*.txt

# ...except the llama-cli capture dumps. Each is hundreds of KB, it is
# regenerable, and it is only an input to gpu-evidence-<label>.txt. Without this
# the blanket `!bench/raw/*.txt` above would drag ~1.3 MB per run into the repo.
bench/raw/llama-cli-verbose*.txt
bench/raw/llama-cli-ngl99-verbose*.txt

# ---- local config (personal paths and ports — never commit) ------------------
config.sh

# ---- llama.cpp sources and build output (large, rebuildable) -----------------
llama.cpp/
build/
*.o
*.so
*.so.*

# ---- model weights (gigabytes — never commit) --------------------------------
*.gguf
*.bin
*.safetensors

# ---- caches / editors --------------------------------------------------------
.cache/
__pycache__/
*.pyc
.viminfo
.DS_Store
